# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Environment Variables & Secrets (CRITICAL: Never commit API keys)
.env
.env.local
*.env
*.env.*
!.env.example

# SQLite Database & temporary WAL files (auto-seeded on startup)
*.db
*.db-shm
*.db-wal
*.sqlite

# Large dataset raw files and archives (>100MB exceeds GitHub limits)
*.7z
*.zip
*.tar.gz
*.parquet
dataset/raw/**/*.7z
dataset/raw/**/*.parquet

# Jupyter
.ipynb_checkpoints/

# PyTorch model checkpoints (large binaries — keep only final .pth)
models/mri_SimpleCNN_checkpoint.pth
models/mri_MobileNetV2_checkpoint.pth
models/mri_ResNet18_checkpoint.pth
models/mri_EfficientNet-B0_checkpoint.pth

# Torch hub cache
.cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Node modules — NEVER commit these
node_modules/
**/node_modules/

# Next.js build output
dashboard/.next/
**/.next/

# Vite
.vite/
**/.vite/

# Logs
logs/*.log
*.log
